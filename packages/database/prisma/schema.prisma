generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  AGENT
  VIEWER
}

enum InstagramAccountStatus {
  CONNECTING
  CONNECTED
  TOKEN_EXPIRED
  TOKEN_REVOKED
  PERMISSION_ERROR
  WEBHOOK_ERROR
  DISCONNECTED
  ERROR
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  SPAM
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageSender {
  CUSTOMER
  AI
  AGENT
  SYSTEM
}

enum MessageStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  FAILED
  READ
}

enum SubscriptionPlan {
  FREE
  STARTER
  PRO
  BUSINESS
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model User {
  id              String            @id @default(cuid())
  email           String            @unique
  passwordHash    String
  name            String
  avatarUrl       String?
  emailVerifiedAt DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  workspaces      Workspace[]       @relation("WorkspaceOwner")
  memberships     WorkspaceMember[]
  auditLogs       AuditLog[]
  notes           ConversationNote[]
  assignedConversations Conversation[] @relation("AssignedAgent")
  notifications   Notification[]
}

model Workspace {
  id              String            @id @default(cuid())
  name            String
  slug            String            @unique
  ownerId         String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  owner           User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members         WorkspaceMember[]
  instagramAccounts InstagramAccount[]
  conversations   Conversation[]
  contacts        Contact[]
  automations     Automation[]
  aiSettings      AISettings[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  usageRecords    UsageRecord[]
  subscription    Subscription?
  apiKeys         ApiKey[]
  tags            Tag[]
  teams           Team[]
  knowledgeBase   KnowledgeBase[]
  businessHours   BusinessHours[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        Role      @default(AGENT)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model InstagramAccount {
  id                 String                 @id @default(cuid())
  workspaceId        String
  externalAccountId  String
  username           String
  name               String?
  profilePictureUrl  String?
  accountType        String?                // BUSINESS / CREATOR
  status             InstagramAccountStatus @default(CONNECTED)
  connectedAt        DateTime               @default(now())
  lastValidatedAt    DateTime?
  tokenExpiresAt     DateTime?
  lastWebhookAt      DateTime?
  messagingReady     Boolean                @default(false)
  webhookReady       Boolean                @default(false)
  aiReady            Boolean                @default(false)
  lastError          String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  workspace          Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  credential         InstagramCredential?
  conversations      Conversation[]
  contacts           Contact[]
  automations        Automation[]
  aiSettings         AISettings?
  webhookEvents      WebhookEvent[]
  businessHours      BusinessHours[]
  knowledgeBase      KnowledgeBase[]

  @@unique([workspaceId, externalAccountId])
  @@index([workspaceId])
  @@index([externalAccountId])
  @@index([username])
  @@index([status])
}

model InstagramCredential {
  id                   String           @id @default(cuid())
  instagramAccountId   String           @unique
  encryptedAccessToken String           @db.Text
  tokenType            String           @default("Bearer")
  expiresAt            DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  instagramAccount     InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
}

model Contact {
  id                 String           @id @default(cuid())
  workspaceId        String
  instagramAccountId String
  externalUserId     String           // Instagram IGSID (Scoped User ID)
  username           String?
  name               String?
  profilePictureUrl  String?
  metadata           Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  workspace          Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount   InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  conversations      Conversation[]

  @@unique([instagramAccountId, externalUserId])
  @@index([workspaceId])
  @@index([instagramAccountId])
  @@index([externalUserId])
}

model Conversation {
  id                 String             @id @default(cuid())
  workspaceId        String
  instagramAccountId String
  contactId          String
  status             ConversationStatus @default(OPEN)
  assignedAgentId    String?
  aiEnabled          Boolean            @default(true)
  unreadCount        Int                @default(0)
  lastMessageAt      DateTime           @default(now())
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount   InstagramAccount   @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  contact            Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedAgent      User?              @relation("AssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  messages           Message[]
  tags               ConversationTag[]
  notes              ConversationNote[]

  @@index([workspaceId])
  @@index([instagramAccountId])
  @@index([contactId])
  @@index([status])
  @@index([lastMessageAt])
}

model Message {
  id                String           @id @default(cuid())
  conversationId    String
  externalMessageId String?          @unique // Meta message ID (mid.$...)
  direction         MessageDirection
  senderType        MessageSender
  messageType       String           @default("text")
  text              String?          @db.Text
  mediaUrl          String?          @db.Text
  metadata          Json?
  status            MessageStatus    @default(SENT)
  createdAt         DateTime         @default(now())

  conversation      Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([externalMessageId])
  @@index([direction])
  @@index([createdAt])
}

model AISettings {
  id                  String           @id @default(cuid())
  workspaceId         String
  instagramAccountId  String           @unique
  enabled             Boolean          @default(false)
  provider            String           @default("gemini") // gemini / openai / gemini_live
  model               String           @default("gemini-1.5-flash")
  systemPrompt        String           @default("Sen kurumsal ve profesyonel bir Instagram müşteri temsilcisisin. Doğal, kibar ve Türkçe cevaplar ver.") @db.Text
  temperature         Float            @default(0.7)
  maxTokens           Int              @default(500)
  language            String           @default("tr")
  fallbackMessage     String           @default("Bu konuda size daha iyi yardımcı olabilmek adına sizi müşteri temsilcimize aktarıyorum.") @db.Text
  confidenceThreshold Float            @default(0.75)
  handoffKeywords     String[]         @default(["yetkili", "insan", "temsilci", "yardım", "canlı destek", "telefon"])
  businessHoursOnly   Boolean          @default(false)
  autoReplyDelay      Int              @default(3) // saniye cinsinden debounce
  humanHandoffEnabled Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  workspace           Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount    InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model KnowledgeBase {
  id                 String           @id @default(cuid())
  workspaceId        String
  instagramAccountId String?
  title              String
  content            String           @db.Text
  tags               String[]         @default([])
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  workspace          Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount   InstagramAccount? @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([instagramAccountId])
}

model Automation {
  id                 String           @id @default(cuid())
  workspaceId        String
  instagramAccountId String?
  name               String
  isActive           Boolean          @default(true)
  priority           Int              @default(1)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  workspace          Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount   InstagramAccount? @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  rules              AutomationRule[]
  executions         AutomationExecution[]

  @@index([workspaceId])
  @@index([instagramAccountId])
}

model AutomationRule {
  id           String     @id @default(cuid())
  automationId String
  trigger      String     // MESSAGE_RECEIVED, KEYWORD, FIRST_MESSAGE etc.
  conditions   Json       // Array of conditions
  actions      Json       // Array of actions
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
}

model AutomationExecution {
  id             String     @id @default(cuid())
  automationId   String
  conversationId String
  startedAt      DateTime   @default(now())
  finishedAt     DateTime?
  status         String     // SUCCESS, FAILED, RUNNING
  error          String?    @db.Text
  metadata       Json?

  automation     Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
  @@index([conversationId])
}

model BusinessHours {
  id                 String           @id @default(cuid())
  workspaceId        String
  instagramAccountId String?
  dayOfWeek          Int              // 1 = Pazartesi, 7 = Pazar
  openTime           String           @default("09:00") // HH:mm
  closeTime          String           @default("18:00") // HH:mm
  isClosed           Boolean          @default(false)

  workspace          Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount   InstagramAccount? @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, instagramAccountId, dayOfWeek])
  @@index([workspaceId])
}

model WebhookEvent {
  id                 String            @id @default(cuid())
  externalEventId    String            @unique // Unique event hash or mid for deduplication
  instagramAccountId String?
  eventType          String
  payloadHash        String
  payload            Json
  status             String            @default("PENDING") // PENDING, PROCESSED, FAILED
  attempts           Int               @default(0)
  processedAt        DateTime?
  createdAt          DateTime          @default(now())

  instagramAccount   InstagramAccount? @relation(fields: [instagramAccountId], references: [id], onDelete: SetNull)

  @@index([externalEventId])
  @@index([instagramAccountId])
  @@index([status])
  @@index([createdAt])
}

model AuditLog {
  id           String    @id @default(cuid())
  workspaceId  String
  userId       String?
  action       String
  resourceType String
  resourceId   String?
  ip           String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime  @default(now())

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Notification {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String?
  title       String
  message     String    @db.Text
  type        String    @default("INFO")
  isRead      Boolean   @default(false)
  link        String?
  createdAt   DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId])
  @@index([isRead])
}

model UsageRecord {
  id          String    @id @default(cuid())
  workspaceId String
  metric      String    // messages, ai_tokens, automations, webhook_events
  count       Int       @default(0)
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, metric, periodStart])
  @@index([workspaceId])
}

model Subscription {
  id                 String             @id @default(cuid())
  workspaceId        String             @unique
  plan               SubscriptionPlan   @default(FREE)
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime           @default(now())
  limits             Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  keyHash     String    @unique
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Tag {
  id          String            @id @default(cuid())
  workspaceId String
  name        String
  color       String            @default("#3b82f6")
  createdAt   DateTime          @default(now())

  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations ConversationTag[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model ConversationTag {
  conversationId String
  tagId          String

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag            Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([conversationId, tagId])
}

model ConversationNote {
  id             String       @id @default(cuid())
  conversationId String
  authorId       String
  content        String       @db.Text
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Team {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  description String?
  createdAt   DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}
