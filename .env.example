# ==============================================================================
# INSTAGRAM AI BOT SAAS — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=4000
WEB_PORT=3000

# Base URLs
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# PostgreSQL Database Connection
DATABASE_URL=postgresql://postgres:postgres_secure_password@localhost:5432/instagrambot?schema=public

# Redis Connection (BullMQ, Caching, Locks, Rate Limiting)
REDIS_URL=redis://:redis_secure_password@localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_must_be_at_least_32_chars_long
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_must_be_at_least_32_chars_long
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=super_secret_cookie_signing_key_32_chars

# Instagram Token Encryption (AES-256-GCM) — Must be 32 bytes (64 hex characters or 32 random chars)
INSTAGRAM_TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ==============================================================================
# META / INSTAGRAM GRAPH API CREDENTIALS (Centralized Source of Truth)
# ==============================================================================
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_GRAPH_API_VERSION=v21.0
META_GRAPH_API_BASE_URL=https://graph.facebook.com
META_OAUTH_REDIRECT_URI=http://localhost:4000/api/integrations/instagram/callback
META_WEBHOOK_VERIFY_TOKEN=custom_random_secure_verify_token_here
META_WEBHOOK_SECRET=your_meta_app_secret
META_INSTAGRAM_SCOPES=instagram_basic,instagram_manage_messages,pages_show_list,pages_read_engagement,pages_manage_metadata

# ==============================================================================
# AI ENGINE CONFIGURATION (Default: Gemini, Fallback: OpenAI)
# ==============================================================================
AI_DEFAULT_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash
# Optional: Future v2 Gemini Live Multimodal WebSocket endpoint
GEMINI_LIVE_WS_ENDPOINT=wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1alpha.GenerativeService.BidiGenerateContent

OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Rate Limiting & Protections
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100
WEBHOOK_RATE_LIMIT_LIMIT=300

# Admin Seed Account
ADMIN_EMAIL=admin@instagrambot.local
ADMIN_PASSWORD=AdminSecurePassword123!
